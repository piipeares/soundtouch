# ------------------------------------------------------------------
# SoundTouch Instrumentos — variables de entorno
#
# Copiá este archivo a .env.local y ajustalo. Las NEXT_PUBLIC_* se
# inlinean en el bundle del cliente al buildear: NO son secretos.
# Fuente única de contacto: src/config/business.ts
# ------------------------------------------------------------------

# --- Identidad y contacto del negocio ---
NEXT_PUBLIC_BUSINESS_NAME=SoundTouch Instrumentos
# Número de WhatsApp en formato internacional SIN "+" (formato wa.me:
# país + 9 + código de área + número). El link wa.me se deriva de acá.
NEXT_PUBLIC_BUSINESS_WHATSAPP=5491131736468
NEXT_PUBLIC_BUSINESS_EMAIL=wylap@yahoo.com.ar
NEXT_PUBLIC_BUSINESS_CITY=Buenos Aires, Argentina
# URL pública del sitio — se usará para SEO (sitemap/metadata). En
# producción poné tu dominio real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Única fuente de la tasa de cambio: 1 USD = N ARS (aprox.)
NEXT_PUBLIC_EXCHANGE_RATE=1050

# --- Admin auth (solo server; se consume en /api/auth, WU3) ---
# Credenciales del admin. NO usen los placeholders en producción.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me
# SESSION_SECRET=genera-un-string-largo-al-azar